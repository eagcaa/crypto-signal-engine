APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://crypto:crypto@localhost:5432/crypto_signal_engine

BINANCE_ENABLED=true
BYBIT_ENABLED=true
COINGLASS_ENABLED=false

# Paper trading is fully local and never sends exchange orders.
PAPER_TRADING_ENABLED=false
PAPER_STARTING_EQUITY=10000
PAPER_RISK_PER_TRADE_PCT=0.50
PAPER_MAX_NOTIONAL_PCT=10
PAPER_MAX_OPEN_POSITIONS=1
PAPER_MAX_DRAWDOWN_PCT=5.00
PAPER_MAX_CONSECUTIVE_LOSSES=5

# Optional Telegram alerts. Keep secrets only in local .env / server secrets.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Replay-generated calibration artifact used by live alerts.
CALIBRATION_FILE=runtime-data/calibration.json
CALIBRATION_MAX_AGE_HOURS=168

# Alert only after repeated low-quality snapshots to avoid noise.
DATA_QUALITY_ALERT_THRESHOLD=0.67
DATA_QUALITY_BAD_INTERVALS=3

# Public Binance/Bybit market-data streams do not require credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# CoinGlass REST API requires a CG-API-KEY.
COINGLASS_API_KEY=
